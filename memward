#!/usr/bin/env bash

set -euo pipefail

resolve_script_dir() {
  local source_path="$1"
  while [ -L "$source_path" ]; do
    local source_dir
    source_dir="$(cd "$(dirname "$source_path")" && pwd -P)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" != /* ]] && source_path="$source_dir/$source_path"
  done
  cd "$(dirname "$source_path")" && pwd -P
}

APP_DIR="${MEMWARD_APP_DIR:-$(resolve_script_dir "$0")}"
CLAUDE_SETTINGS_DIR="$HOME/.claude"
CLAUDE_SETTINGS_FILE="$CLAUDE_SETTINGS_DIR/settings.json"

info() {
  printf '[memward] %s\n' "$1"
}

fail() {
  printf '[memward] Error: %s\n' "$1" >&2
  exit 1
}

set_env_value() {
  local key="$1"
  local value="$2"
  local env_file="$3"

  if grep -qE "^${key}=" "$env_file"; then
    perl -0pi -e "s|^${key}=.*$|${key}=${value}|m" "$env_file"
  else
    printf '\n%s=%s\n' "$key" "$value" >> "$env_file"
  fi
}

prompt_env_value() {
  local key="$1"
  local prompt_text="$2"
  local secret="${3:-false}"
  local current_value=""

  if [ -f "$APP_DIR/.env" ]; then
    current_value="$(perl -ne 'print "$1\n" if /^'"$key"'=(.*)$/' "$APP_DIR/.env")"
  fi

  if [ -n "$current_value" ] && [ "$current_value" != "sk-or-v1-..." ] && [ "$current_value" != "postgresql://postgres:password@db.your-project.supabase.co:5432/postgres" ]; then
    info "$key already set in .env"
    return
  fi

  if [ "$secret" = "true" ]; then
    printf '[memward] %s: ' "$prompt_text"
    stty -echo
    IFS= read -r input_value
    stty echo
    printf '\n'
  else
    printf '[memward] %s: ' "$prompt_text"
    IFS= read -r input_value
  fi

  if [ -z "$input_value" ]; then
    fail "$key is required to continue."
  fi

  set_env_value "$key" "$input_value" "$APP_DIR/.env"
}

prompt_mode() {
  info "Choose install mode:"
  PS3='Select install mode: '
  select selected_mode in "local"; do
    if [ -n "$selected_mode" ]; then
      break
    fi
    info "Please choose a valid install mode."
  done

  set_env_value "MEMWARD_MODE" "$selected_mode" "$APP_DIR/.env"
}

prompt_database_choice() {
  info "Choose database:"
  PS3='Select database: '
  select selected_db in "local" "supabase"; do
    if [ -n "$selected_db" ]; then
      break
    fi
    info "Please choose a valid database option."
  done

  if [ "$selected_db" = "local" ]; then
    info "Using local SQLite database under ~/.memward/."
    set_env_value "SUPABASE_DB_URL" "" "$APP_DIR/.env"
  else
    prompt_env_value "SUPABASE_DB_URL" "Enter your Supabase/Postgres connection string"
  fi
}

prompt_agent_choice() {
  info "Choose agent integration:"
  PS3='Select agent: '
  select selected_agent in "claude-code"; do
    if [ -n "$selected_agent" ]; then
      printf '%s\n' "$selected_agent"
      return
    fi
    info "Please choose a valid agent option."
  done
}

setup_claude_code() {
  local stop_hook="$APP_DIR/connectors/claude_code/stop_hook.py"
  local session_start_hook="$APP_DIR/connectors/claude_code/session_start_hook.py"
  local prompt_hook="$APP_DIR/connectors/claude_code/prompt_hook.py"

  chmod +x "$stop_hook" "$session_start_hook" "$prompt_hook"
  mkdir -p "$CLAUDE_SETTINGS_DIR"

  CLAUDE_SETTINGS_FILE="$CLAUDE_SETTINGS_FILE" \
  MEMWARD_STOP_HOOK="$stop_hook" \
  MEMWARD_SESSION_START_HOOK="$session_start_hook" \
  MEMWARD_PROMPT_HOOK="$prompt_hook" \
  python3 <<'PY'
import json
import os
from pathlib import Path

settings_path = Path(os.environ["CLAUDE_SETTINGS_FILE"])
stop_hook = os.environ["MEMWARD_STOP_HOOK"]
session_start_hook = os.environ["MEMWARD_SESSION_START_HOOK"]
prompt_hook = os.environ["MEMWARD_PROMPT_HOOK"]

if settings_path.exists():
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8"))
    except Exception:
        data = {}
else:
    data = {}

hooks = data.setdefault("hooks", {})


def ensure_command(hook_name: str, command: str, timeout: int | None = None) -> None:
    entries = hooks.setdefault(hook_name, [])
    for entry in entries:
        if isinstance(entry, dict) and entry.get("type") == "command" and entry.get("command") == command:
            if timeout is not None:
                entry["timeout"] = timeout
            return

    payload = {"type": "command", "command": command}
    if timeout is not None:
        payload["timeout"] = timeout
    entries.append(payload)


ensure_command("Stop", stop_hook)
ensure_command("SessionStart", session_start_hook)
ensure_command("UserPromptSubmit", prompt_hook, timeout=5)

settings_path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
PY

  info "Claude Code hooks installed in $CLAUDE_SETTINGS_FILE"
}

cmd_init() {
  local agent_choice

  if [ ! -f "$APP_DIR/.env" ]; then
    info "Creating .env from .env.example..."
    cp "$APP_DIR/.env.example" "$APP_DIR/.env"
  else
    info "Keeping existing .env file."
  fi

  prompt_mode
  prompt_database_choice
  prompt_env_value "LLM_API_KEY" "Enter your LLM API key" "true"
  agent_choice="$(prompt_agent_choice)"

  if [ "$agent_choice" = "claude-code" ]; then
    setup_claude_code
  fi

  cat <<EOF

[memward] Initialization complete.

Next:
  memward start

EOF
}

cmd_start() {
  if [ ! -f "$APP_DIR/.env" ]; then
    fail "Missing $APP_DIR/.env. Run 'memward init' first."
  fi

  exec bash "$APP_DIR/start.sh"
}

cmd_help() {
  cat <<EOF
memward commands:
  memward init     Initialize local configuration
  memward start    Start the memward services
EOF
}

case "${1:-help}" in
  init)
    cmd_init
    ;;
  start)
    cmd_start
    ;;
  help|-h|--help)
    cmd_help
    ;;
  *)
    fail "Unknown command: $1"
    ;;
esac
